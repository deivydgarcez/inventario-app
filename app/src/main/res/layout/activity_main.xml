<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/screenBackground"
    android:fitsSystemWindows="true">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/colorPrimary"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="18dp"
        android:elevation="4dp">

        <!-- Linha do topo: logo à esquerda, modo escuro à direita -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <ImageView
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:scaleType="fitStart"
                android:src="@drawable/logo_pontual"
                android:tint="#FFFFFF"
                android:contentDescription="Pontual Tecnologia" />

            <ImageButton
                android:id="@+id/btnDarkMode"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:tint="#FFFFFF"
                android:contentDescription="Modo escuro" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvNome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Olá!"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeposito"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Nenhum depósito selecionado"
            android:textColor="@color/headerTextSecondary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Actions area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Selecionar Depósito -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelecionarDeposito"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:text="Selecionar Depósito"
            android:textSize="15sp"
            app:icon="@drawable/ic_store"
            app:iconTint="?attr/colorPrimary"
            app:iconSize="22dp"
            app:cornerRadius="10dp" />

        <!-- Iniciar Coleta — botão principal, ocupa o espaço restante -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBipar"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            android:text="Iniciar Coleta"
            android:textSize="20sp"
            android:textStyle="bold"
            android:enabled="false"
            app:icon="@drawable/ic_camera"
            app:iconSize="28dp"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:cornerRadius="14dp" />

        <!-- Ver Relatório -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRelatorio"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:text="Ver Relatório"
            android:textSize="15sp"
            android:enabled="false"
            app:icon="@drawable/ic_report"
            app:iconTint="?attr/colorPrimary"
            app:iconSize="22dp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUsuarios"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:text="Acesso Mobile — Usuários"
            android:textSize="14sp"
            android:visibility="gone"
            app:icon="@drawable/ic_person"
            app:iconTint="?attr/colorPrimary"
            app:iconSize="20dp"
            app:cornerRadius="10dp" />

    </LinearLayout>

    <!-- Footer: Sair | Servidor -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSair"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Sair da conta"
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            app:icon="@drawable/ic_logout"
            app:iconTint="@color/textSecondary"
            app:iconSize="18dp"
            app:strokeColor="@color/textSecondary"
            app:cornerRadius="22dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfigurarServidor"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Servidor"
            android:textColor="@color/textSecondary"
            android:textSize="13sp"
            app:icon="@drawable/ic_settings"
            app:iconTint="@color/textSecondary"
            app:iconSize="16dp"
            app:strokeColor="@color/textSecondary"
            app:cornerRadius="22dp" />

    </LinearLayout>

</LinearLayout>
