<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:background="@color/glassToolbarFill"
        android:elevation="0dp"
        android:theme="@style/Theme.Inventario.ToolbarOverlay"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Barra de resumo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/glassToolbarFill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvOnlinePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● Online"
            android:textSize="11sp"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@drawable/bg_pill" />

        <TextView
            android:id="@+id/tvTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="0 itens"
            android:textSize="13sp"
            android:textColor="@color/textSecondary" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Dica swipe -->
    <TextView
        android:id="@+id/tvDicaSwipe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="← Deslize para excluir   ·   Toque para editar"
        android:textSize="11sp"
        android:textColor="@color/textSecondary"
        android:gravity="center"
        android:paddingVertical="5dp"
        android:paddingHorizontal="16dp"
        android:background="@color/glassToolbarFill"
        android:visibility="gone" />

    <!-- Lista -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false" />

    <!-- Aviso: produtos não contados -->
    <TextView
        android:id="@+id/tvAvisoNaoContados"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:background="#CCB71C1C"
        android:textColor="@android:color/white"
        android:textStyle="bold"
        android:textSize="12sp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:visibility="gone" />

    <!-- Área de ações -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/glassToolbarFill"
        android:paddingHorizontal="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- Histórico + Auditoria (glass card style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/btnHistorico"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_glass_card"
                android:foreground="?attr/selectableItemBackground"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_history"
                    android:tint="@color/iceCreamBlueDark"
                    android:contentDescription="" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Histórico"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/iceCreamBlueDark" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnAuditoria"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center"
                android:background="@drawable/bg_glass_card"
                android:foreground="?attr/selectableItemBackground"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_report"
                    android:tint="@color/iceCreamBlueDark"
                    android:contentDescription="" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Auditoria"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/iceCreamBlueDark" />

            </LinearLayout>

        </LinearLayout>

        <!-- Sincronizar — só quando offline com pendentes -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSincronizar"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="8dp"
            android:text="↑ Sincronizar scans pendentes"
            android:textSize="13sp"
            android:visibility="gone"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:strokeColor="@color/colorPrimary"
            app:backgroundTint="#26FFFFFF"
            app:cornerRadius="16dp" />

        <!-- Recontagem -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRecontagem"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="Fazer Recontagem"
            android:textSize="14sp"
            android:textStyle="bold"
            android:enabled="false"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:cornerRadius="16dp"
            app:backgroundTint="#FF388E3C" />

        <!-- Aviso de bloqueio -->
        <TextView
            android:id="@+id/tvAvisoBloqueio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#CCFF8F00"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="12sp"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:visibility="gone" />

        <!-- Consolidar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConsolidar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="Consolidar Inventário"
            android:textSize="16sp"
            android:textStyle="bold"
            android:enabled="false"
            android:elevation="0dp"
            android:stateListAnimator="@null"
            app:cornerRadius="16dp"
            app:backgroundTint="@color/colorPrimary" />

    </LinearLayout>

</LinearLayout>
